{
  "name": "foundphone-studio",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "npm run story:build && vite --config vite.runtime.config.ts --host 0.0.0.0",
    "build": "npm run story:build && tsc -b && vite build --config vite.runtime.config.ts && node scripts/package-runtime.mjs",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "lint": "eslint src",
    "preview": "vite preview --host 0.0.0.0",
    "test:e2e": "node node_modules/@playwright/test/cli.js test",
    "licenses": "node scripts/licenses.mjs",
    "story:validate": "node scripts/story.mjs validate",
    "story:build": "node scripts/story.mjs build",
    "story:preview": "npm run dev",
    "story:test": "node scripts/story.mjs test"
  },
  "dependencies": {
    "@tiptap/react": "^3.0.0",
    "@tiptap/starter-kit": "^3.0.0",
    "@xyflow/react": "^12.8.5",
    "dexie": "^4.2.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "motion": "^12.23.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.39.0",
    "globals": "^16.4.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.0",
    "vite-plugin-pwa": "^1.1.0",
    "vitest": "^5.0.5"
  }
}
